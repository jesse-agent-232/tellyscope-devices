{
  "schema": 1,
  "id": "epson-ls800",
  "name": "Epson LS800 laser projector",
  "tested": {
    "os": "Android TV 14",
    "sdk": 34,
    "build": null
  },
  "launcher": "com.google.android.tvlauncher",
  "keep": [],
  "groups": [
    {
      "title": "Batch 1: telemetry",
      "packages": [
        {
          "pkg": "com.google.android.feedback",
          "note": "Google feedback reporter"
        },
        {
          "pkg": "com.android.tv.feedbackconsent",
          "note": "feedback/diagnostics consent prompt"
        }
      ]
    },
    {
      "title": "Batch 2: ads and content plumbing",
      "packages": [
        {
          "pkg": "com.google.android.tvrecommendations",
          "note": "firmware re-enables it (lastDisabledCaller: com.droidlogic), see header",
          "optional": true
        },
        {
          "pkg": "android.autoinstalls.config.askey.tvbox",
          "note": "Play auto-install of partner apps"
        },
        {
          "pkg": "com.android.adservices.api",
          "note": "Android ad services (Topics, attribution)"
        },
        {
          "pkg": "com.android.printspooler",
          "note": "print spooler, no printers on a projector"
        }
      ]
    },
    {
      "title": "Batch 3: preloaded / unused apps (owner's choice)",
      "packages": [
        {
          "pkg": "com.google.android.play.games"
        },
        {
          "pkg": "com.instagram.airwave"
        },
        {
          "pkg": "tv.pluto.android"
        },
        {
          "pkg": "com.epson.onlinemeetings",
          "note": "Epson Online Meetings (video conferencing), owner does not use it"
        }
      ]
    }
  ],
