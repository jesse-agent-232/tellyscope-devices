{
  "schema": 1,
  "id": "jvc-android-tv-menlo",
  "name": "JVC Android TV",
  "tested": {
    "os": "Android TV 11",
    "sdk": 30,
    "build": null
  },
  "launcher": "com.google.android.tvlauncher",
  "keep": [],
  "groups": [
    {
      "title": "Vestel telemetry and \"cleaner\"",
      "packages": [
        {
          "pkg": "com.vestel.vestelreporter",
          "note": "Vestel reporter: INTERNET + BOOT_COMPLETED, no UI"
        },
        {
          "pkg": "com.vestel.tv.speedup",
          "note": "\"speed up\" cleaner"
        },
        {
          "pkg": "com.vestel.smartcenter",
          "note": "no UI, holds GET_TASKS (sees which apps you run) + INTERNET"
        }
      ]
    },
    {
      "title": "Google/partner attribution, feedback, auto-installs, setup leftovers",
      "packages": [
        {
          "pkg": "com.google.android.partnersetup",
          "note": "partner/OEM attribution"
        },
        {
          "pkg": "com.google.android.feedback",
          "note": "Google feedback reporter"
        },
        {
          "pkg": "com.google.android.onetimeinitializer"
        },
        {
          "pkg": "android.autoinstalls.config.vestel.coma",
          "note": "Vestel auto-install stub (preloads apps at setup)"
        },
        {
          "pkg": "com.mstar.android.tv.disclaimercustomization",
          "note": "disclaimer screen used only by first-run setup"
        }
      ]
    },
    {
      "title": "Preloaded apps (off by choice, per the owner; Prime Video and Disney+ kept)",
      "packages": [
        {
          "pkg": "com.google.android.youtube.tvmusic",
          "note": "YouTube Music"
        },
        {
          "pkg": "com.google.android.videos",
          "note": "Play Movies & TV"
        },
        {
          "pkg": "com.google.android.play.games",
          "note": "Play Games"
        },
        {
          "pkg": "com.google.android.katniss",
          "note": "Google Assistant / voice search"
        },
        {
          "pkg": "com.android.mgstv",
          "note": "Mango TV, preinstalled as a user app (Taobao ACCS push + Firebase)"
        },
        {
          "pkg": "com.tcl.browser",
          "note": "TCL Browser, preinstalled as a user app"
        }
      ]
    },
    {
      "title": "Background services nobody needs on a TV",
      "packages": [
        {
          "pkg": "com.android.printspooler"
        },
        {
          "pkg": "com.android.backupconfirm"
        },
        {
          "pkg": "com.android.sharedstoragebackup"
        },
        {
          "pkg": "com.android.wallpaperbackup"
        },
        {
          "pkg": "com.google.android.syncadapters.calendar"
        },
        {
          "pkg": "com.android.providers.calendar"
        },
        {
          "pkg": "com.android.dynsystem",
          "note": "Dynamic System Updates"
        },
        {
          "pkg": "com.android.cts.ctsshim",
          "note": "Android test shim"
        },
        {
          "pkg": "com.android.cts.priv.ctsshim",
          "note": "Android test shim"
        }
      ]
    },
    {
      "title": "Only safe once com.gathin.tvhome owns Home and com.google.android.tvlauncher is disabled",
      "packages": [
        {
          "pkg": "com.google.android.tvrecommendations",
          "note": "launcher recommendation rows"
        },
        {
          "pkg": "com.google.android.backdrop",
          "note": "ambient-mode screensaver; the launcher's Clock screensaver replaces it"
        }
      ]
    },
    {
      "title": "Stock launcher, replaced by launcher/",
      "packages": [
        {
          "pkg": "com.google.android.tvlauncher",
          "note": "launcher/build-and-install.sh disables the stock launcher itself, after Home has moved",
          "optional": true
        }
      ]
    }
  ],
  "source": {
    "repo": "Gathin23/cleanyourtv",
    "path": "examples/jvc-android-tv-menlo/debloat.txt",
    "commit": "204143007f0bebfb14d6ef001a32e5836b1c90b5"
  }
}
