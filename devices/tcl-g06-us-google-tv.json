{
  "schema": 1,
  "id": "tcl-g06-us-google-tv",
  "name": "TCL Smart TV",
  "tested": {
    "os": "Google TV 11",
    "sdk": 30,
    "build": "AR2101"
  },
  "launcher": "com.google.android.apps.tv.launcherx",
  "keep": [],
  "groups": [
    {
      "title": "Batch 1: TCL promos, popups and telemetry; Google partner plumbing",
      "packages": [
        {
          "pkg": "com.tcl.esticker",
          "note": "store-demo sticker"
        },
        {
          "pkg": "com.tcl.partnercustomizer",
          "note": "promo rows (see KEEP note on #2138)"
        },
        {
          "pkg": "com.tcl.messagebox",
          "note": "TCL messages/popups"
        },
        {
          "pkg": "com.tcl.dashboard",
          "note": "TCL Home panel; the remote's dashboard button goes dead with it"
        },
        {
          "pkg": "com.tcl.useragreement"
        },
        {
          "pkg": "com.tcl.guard",
          "note": "TGuard cleaner"
        },
        {
          "pkg": "com.tcl.copydatatotv",
          "note": "copy-data utility"
        },
        {
          "pkg": "com.tcl.usercenter",
          "note": "TCL account, switched back on at every boot (idle)",
          "optional": true
        },
        {
          "pkg": "com.tcl.smartalexa",
          "note": "Alexa bridge, switched back on at every boot (idle)",
          "optional": true
        },
        {
          "pkg": "com.google.android.partnersetup",
          "note": "partner attribution"
        },
        {
          "pkg": "com.google.android.feedback"
        },
        {
          "pkg": "com.google.android.onetimeinitializer"
        },
        {
          "pkg": "com.google.android.syncadapters.calendar"
        },
        {
          "pkg": "com.google.android.apps.nbu.smartconnect.tv",
          "note": "data-saver VPN"
        },
        {
          "pkg": "android.autoinstalls.config.google.gtvpai",
          "note": "partner auto-installs"
        }
      ]
    },
    {
      "title": "Batch 2: preloads, off by the owner's choice",
      "packages": [
        {
          "pkg": "com.tcl.channelplus",
          "note": "TCL Live FAST channels (a Live TV input)"
        },
        {
          "pkg": "com.tcl.tv.tclchannel",
          "note": "TCL Channel; the remote's TCL Channel button goes dead with it"
        },
        {
          "pkg": "com.tcl.tv.plus",
          "note": "TCL TV+ free channels"
        },
        {
          "pkg": "com.netflix.ninja",
          "note": "Netflix; the remote's Netflix button goes dead with it; an owner's app, kept on in the shared list; this set has it off",
          "optional": true
        },
        {
          "pkg": "com.google.android.videos",
          "note": "Play Movies"
        },
        {
          "pkg": "com.google.android.play.games"
        },
        {
          "pkg": "com.google.android.marvin.talkback",
          "note": "TalkBack"
        },
        {
          "pkg": "com.tcl.t_solo",
          "note": "Bluetooth \"listen alone\""
        }
      ]
    },
    {
      "title": "Disabling setupwraith gives Home to a new launcher but can break casting (Chromecast built-in) on some",
      "packages": [
        {
          "pkg": "com.google.android.tungsten.setupwraith"
        }
      ]
    }
  ],
