{
  "schema": 1,
  "id": "noblex-shinjuku",
  "name": "Noblex NoblexTV",
  "tested": {
    "os": "Android TV 11",
    "sdk": 30,
    "build": null
  },
  "launcher": "com.google.android.tvlauncher",
  "keep": [],
  "groups": [
    {
      "title": "--- Batch 1: Skyworth auto-installs, shop demo, setup leftovers, telemetry",
      "packages": [
        {
          "pkg": "android.autoinstalls.config.skyworth",
          "note": "Play Auto Installs config for preloaded apps"
        },
        {
          "pkg": "fusion.android.tv.demo",
          "note": "Skyworth retail demo service, starts at boot"
        },
        {
          "pkg": "com.smartdevice.common.demonow",
          "note": "\"Demo Now\" store demo app"
        },
        {
          "pkg": "com.mstar.android.tv.disclaimercustomization",
          "note": "disclaimer screen used only by the first-run setup"
        },
        {
          "pkg": "com.Smartdevice.emanual",
          "note": "on-screen manual (E-Manual)"
        },
        {
          "pkg": "com.google.android.feedback"
        },
        {
          "pkg": "com.google.android.apps.nbu.smartconnect.tv",
          "note": "Google background data service, starts at boot"
        },
        {
          "pkg": "com.mediatek.testpq",
          "note": "MediaTek picture-quality test tool, starts at boot"
        }
      ]
    },
    {
      "title": "--- Batch 2: recommendation rows, voice, ambient screensaver",
      "packages": [
        {
          "pkg": "com.google.android.tvrecommendations"
        },
        {
          "pkg": "com.smartdevice.leanbacklauncher.customizer",
          "note": "Skyworth's partner config for the stock launcher"
        },
        {
          "pkg": "com.google.android.katniss",
          "note": "Google Assistant / voice search; the mic button stops working"
        },
        {
          "pkg": "com.google.android.backdrop",
          "note": "ambient photo screensaver; use the launcher's Clock instead"
        }
      ]
    },
    {
      "title": "--- Batch 3: not used (by choice)",
      "packages": [
        {
          "pkg": "com.google.android.play.games"
        },
        {
          "pkg": "com.google.android.youtube.tvmusic"
        },
        {
          "pkg": "com.mubi"
        },
        {
          "pkg": "com.mediatek.wwtv.mediaplayer",
          "note": "USB media player; disable.sh skips it here (asks for TV_INPUT_HARDWARE), kept",
          "optional": true
        },
        {
          "pkg": "com.airoha.ble.ota",
          "note": "\"RC Upgrade\": remote firmware updater; pairing still works"
        },
        {
          "pkg": "com.android.providers.calendar"
        },
        {
          "pkg": "com.google.android.syncadapters.calendar"
        }
      ]
    },
    {
      "title": "Stock launcher, replaced by launcher/",
      "packages": [
        {
          "pkg": "com.google.android.tvlauncher",
          "note": "launcher/build-and-install.sh disables it itself, after Home has moved",
          "optional": true
        }
      ]
    }
  ],
  "source": {
    "repo": "Gathin23/cleanyourtv",
    "path": "examples/noblex-shinjuku/debloat.txt",
    "commit": "204143007f0bebfb14d6ef001a32e5836b1c90b5"
  }
}
