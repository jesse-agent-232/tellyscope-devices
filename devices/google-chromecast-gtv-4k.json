          "note": "remote usage logging"
        },
        {
          "pkg": "com.google.android.apps.tv.netoscope",
          "note": "network diagnostics reporting"
        },
        {
          "pkg": "com.google.android.federatedcompute"
        },
        {
          "pkg": "com.google.android.ondevicepersonalization.services"
        },
        {
          "pkg": "com.google.android.adservices.api",
          "note": "Privacy Sandbox ad services"
        },
        {
          "pkg": "com.google.android.ext.adservices.api"
        }
      ]
    },
    {
      "title": "Preloaded apps",
      "packages": [
        {
          "pkg": "com.google.android.play.games"
        },
        {
          "pkg": "com.google.android.videos",
          "note": "Google TV / Play Movies"
        },
        {
          "pkg": "com.android.printspooler"
        },
        {
          "pkg": "com.google.android.marvin.talkback",
          "note": "re-enable if you need the screen reader"
        }
      ]
    },
    {
