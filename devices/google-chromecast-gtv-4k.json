        {
          "pkg": "com.google.android.backdrop"
        }
      ]
    },
    {
      "title": "Stock home. launcher/build-and-install.sh disables launcherx itself once the new launcher is installed",
      "packages": [
        {
          "pkg": "com.google.android.apps.tv.launcherx",
          "optional": true
        },
        {
          "pkg": "com.google.android.tungsten.setupwraith",
          "note": "setup wizard; its RecoveryActivity otherwise takes over Home"
        }
      ]
    }
  ],
